# Little Lemon Restaurant API - Environment Configuration

# Django Core
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# Set DB_ENGINE=mysql to connect to MySQL (Coursera Capstone requirement)
# Set DB_ENGINE=sqlite for local development without MySQL or during test runs
DB_ENGINE=mysql
DB_NAME=littlelemon
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
